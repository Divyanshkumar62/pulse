{
  "$schema": "https://schemas.tauri.app/v2/capabilities",
  "identifier": "default",
  "description": "Default capabilities for Pulse",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted",
    "notification:allow-notify",
    "notification:default",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "sidecar": "cloudflared",
          "args": ["tunnel", "--url", { "validator": ".*" }]
        },
        {
          "sidecar": "binaries/cloudflared",
          "args": ["tunnel", "--url", { "validator": ".*" }]
        }
      ]
    }
  ]
}
