{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "1.1.0",
  "identifier": "com.pulse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pulse - API Client",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "notification": null,
    "fs": {},
    "updater": {
      "endpoints": [
        "https://github.com/Divyanshkumar62/pulse/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGRUUwQzkyREZCMTJFMQpSV1RoRXZzdHllRCtCcEhLelhNbG91WGdFK1R2YnV3eUdLVjFCWDVhSXNDd3dEd0ttL3pSajhxYgo="
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/128x128.png"],
    "category": "DeveloperTool",
    "shortDescription": "A fast, lightweight API client",
    "longDescription": "Pulse is a fast, lightweight Postman alternative built with Tauri, Rust, and React.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "sidebarImage": "icons/sidebar.bmp",
        "headerImage": "icons/header.bmp"
      }
    }
  }
}
